# ── Modular AI Log Analyzer Environment Configuration ─────────────────────────
# Primary Natural Language Reasoning Engine (Google Gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# ── Independent Custom ML Model Service (Render / Local) ─────────────────────
# Deployed separately on Render or running locally (e.g., http://127.0.0.1:8002)
# If left empty, the application runs in graceful degraded diagnostics mode.
ML_MODEL_API_URL=
ML_MODEL_API_KEY=
ML_MODEL_TIMEOUT=5.0

# ── Optional Alternative Cloud LLM Providers ──────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Technical Documentation RAG Settings ─────────────────────────────────────
RAG_INDEX_DIR=data/rag_index
RAG_TOP_K=3

# ── Sequence Anomaly Detection Settings (Retained Local ML) ───────────────────
ANOMALY_MODEL_PATH=ml/models/hdfs_rf.joblib
DRAIN3_STATE_FILE=ml/models/drain3_state.bin

# ── Service & Database Endpoints ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sample_app.db
LOG_FILE=data/logs/sample_app.jsonl
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
