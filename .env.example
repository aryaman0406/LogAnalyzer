# ── Incident Agent V2 Environment Configuration ──────────────────────────────
# Default out-of-the-box provider: local (operates with zero external API keys)
LLM_PROVIDER=local
LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct

# ── Local Model & PEFT / LoRA Settings ───────────────────────────────────────
LOCAL_MODEL_DIR=ml/models/incident_llm
USE_4BIT_QUANTIZATION=true
INFERENCE_DEVICE=cpu

# ── Optional Cloud Provider Adapters (Setups A–C) ────────────────────────────
# Leave blank to run purely with the local fine-tuned model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Technical Documentation RAG Settings ─────────────────────────────────────
RAG_INDEX_DIR=data/rag_index
RAG_TOP_K=3

# ── ML Anomaly Detection Settings ────────────────────────────────────────────
ANOMALY_MODEL_PATH=ml/models/hdfs_rf.joblib
DRAIN3_STATE_FILE=ml/models/drain3_state.bin

# ── Service & Database Endpoints ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sample_app.db
LOG_FILE=data/logs/sample_app.jsonl
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
